---
import Layout from '../layouts/Layout.astro';
import GlobalSearch from '../components/busqueda/GlobalSearch';

/**
 * TJA BCS - Interfaz de Búsqueda Global
 * File: frontend/src/pages/busqueda.astro
 *
 * Route: /busqueda
 * Description: Buscador centralizado de expedientes, acuerdos, audiencias y partes.
 * SSR Protection: Redirige a usuarios no autenticados a /login.
 */

const user = Astro.locals.user;
const token = Astro.locals.token;

if (!user && !token) {
  return Astro.redirect('/login?redirect=' + encodeURIComponent(Astro.url.pathname + Astro.url.search));
}
---

<Layout title="Búsqueda Global - TJA BCS">
  <!-- Breadcrumb Navigation -->
  <nav class="flex items-center space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400 mb-4" aria-label="Breadcrumb">
    <a href="/" class="hover:text-blue-600 transition-colors flex items-center">
      <svg class="w-3.5 h-3.5 mr-1 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      Inicio
    </a>
    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <span class="text-slate-900 dark:text-slate-100 font-semibold" aria-current="page">Búsqueda Global</span>
  </nav>

  <!-- Page Header -->
  <div class="mb-6">
    <h1 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Búsqueda Global</h1>
    <p class="text-slate-600 dark:text-slate-300 mt-1 text-sm">
      Localización ágil de expedientes por folio, sala, tipo de juicio, ley aplicable o extracto procesal.
    </p>
  </div>

  <!-- Interactive React Island for Global Search -->
  <GlobalSearch client:load />
</Layout>
