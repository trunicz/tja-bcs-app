---
/**
 * TJA BCS - Gestión y Directorio de Usuarios
 * Route: /usuarios
 *
 * Provides judicial user directory, role assignments, and the Impersonation Hub.
 * Features full dark mode contrast parity (WCAG 2.1 AA) and server-side breadcrumbs.
 */
import Layout from '../../layouts/Layout.astro';
import UsuariosList from '../../components/UsuariosList.tsx';

const user = Astro.locals.user;
const token = Astro.locals.token;

// Defensive redirect for unauthenticated requests
if (!user && !token) {
  return Astro.redirect('/login?redirect=' + encodeURIComponent(Astro.url.pathname + Astro.url.search));
}

const canCreateUser = Boolean(
  user && (user.rol === 'Administrador' || (Array.isArray(user.permisos) && user.permisos.includes('usuarios:create')))
);
---

<Layout title="Gestión de Usuarios - TJA BCS">
  <!-- Breadcrumb Navigation -->
  <nav class="flex items-center space-x-2 text-xs font-medium text-slate-500 dark:text-slate-400 mb-4" aria-label="Breadcrumb">
    <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors flex items-center">
      <svg class="w-3.5 h-3.5 mr-1 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      Inicio
    </a>
    <svg class="w-3.5 h-3.5 text-slate-400 dark:text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
    </svg>
    <span class="text-slate-900 dark:text-slate-100 font-semibold" aria-current="page">Directorio de Usuarios</span>
  </nav>

  <!-- Page Header with Dark Mode Contrast Parity -->
  <div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-bold text-slate-800 dark:text-slate-100 tracking-tight">Directorio de Usuarios</h1>
      <p class="text-slate-600 dark:text-slate-400 mt-1 text-sm">
        Gestión de personal judicial, asignación de salas, control de cuentas y centro de suplantación.
      </p>
    </div>

    {canCreateUser && (
      <div class="flex items-center gap-2">
        <a
          href="/usuarios/nuevo"
          class="inline-flex items-center gap-2 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white px-4 py-2 rounded-lg shadow-sm hover:shadow font-medium text-sm transition-all duration-150 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
          Nuevo Usuario
        </a>
      </div>
    )}
  </div>

  <!-- Interactive React Island with Impersonation Hub & User Management -->
  <UsuariosList client:load />
</Layout>
