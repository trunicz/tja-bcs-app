---
import Layout from '../../../layouts/Layout.astro';
import EditUsuario from '../../../components/EditUsuario.tsx';

const { id } = Astro.params;
---

<Layout title="Editar Usuario - TJA BCS">
  <div class="mb-6">
    <a href="/usuarios" class="text-blue-600 dark:text-blue-300 hover:underline mb-2 inline-block">← Volver a usuarios</a>
    <h1 class="text-3xl font-bold text-slate-800 dark:text-slate-100">Editar Usuario</h1>
  </div>
  
  <EditUsuario client:load usuarioId={id} />
</Layout>
